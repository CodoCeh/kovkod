<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Открыть терминал здесь</name>
	<submenu></submenu>
	<unique-id>1787165073424245-1</unique-id>
	<command>exo-open --working-directory %f --launch TerminalEmulator</command>
	<description>Открыть терминал в этой папке</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon>wine</icon>
	<name>Открыть с помощью Wine</name>
	<submenu></submenu>
	<unique-id>wine-open-1</unique-id>
	<command>/opt/stol/windows/run-exe.sh %f</command>
	<description>Запустить Windows-программу (.exe/.msi/.bat)</description>
	<range></range>
	<patterns>*.exe;*.msi;*.bat;*.cmd</patterns>
	<startup-notify/>
	<other-files/>
</action>
<action>
	<icon>video-display</icon>
	<name>Запустить с GPU</name>
	<submenu></submenu>
	<unique-id>gpu-run-1</unique-id>
	<command>/opt/stol/gpu/gl-run %f</command>
	<description>Запустить с ускорением Adreno (zink→turnip)</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<other-files/>
</action>
<action>
	<icon>phone</icon>
	<name>На главный экран телефона</name>
	<submenu></submenu>
	<unique-id>kovkod-pin-1</unique-id>
	<command>/opt/stol/kovkod-pin.sh %F</command>
	<description>Значок программы на главном экране Android</description>
	<range></range>
	<patterns>*.desktop</patterns>
	<other-files/>
</action>
<action>
	<icon>video-display</icon>
	<name>Всегда запускать с ускорением GPU</name>
	<submenu></submenu>
	<unique-id>gpu-pref-on-1</unique-id>
	<command>/opt/stol/gpu-pref.sh on %F</command>
	<description>Ярлык будет запускать программу через видеокарту Adreno</description>
	<range></range>
	<patterns>*.desktop</patterns>
	<other-files/>
</action>
<action>
	<icon>video-display</icon>
	<name>Запускать без ускорения GPU</name>
	<submenu></submenu>
	<unique-id>gpu-pref-off-1</unique-id>
	<command>/opt/stol/gpu-pref.sh off %F</command>
	<description>Ярлык будет запускать программу обычным способом</description>
	<range></range>
	<patterns>*.desktop</patterns>
	<other-files/>
</action>
</actions>
