+void vncHandleClipboardImageData(const uint8_t* data, size_t length)
+{
+  struct VncDataTarget* next;
+
+  LOG_DEBUG("Got remote clipboard image data, sending to X11 clients");
+
+  free(cachedImageData);
+  cachedImageData = malloc(length);
+  if (cachedImageData != NULL) {
+    memcpy(cachedImageData, data, length);
+    cachedImageLen = length;
+  } else {
+    cachedImageLen = 0;
+  }
+
+  while (vncImageDataTargetHead != NULL) {
+    int rc;
+    xEvent event;
+
+    rc = vncConvertSelectionImage(vncImageDataTargetHead->client,
+                                  vncImageDataTargetHead->selection,
+                                  vncImageDataTargetHead->target,
+                                  vncImageDataTargetHead->property,
+                                  vncImageDataTargetHead->requestor,
+                                  vncImageDataTargetHead->time,
+                                  cachedImageData, cachedImageLen);
+    if (rc != Success) {
+      event.u.u.type = SelectionNotify;
+      event.u.selectionNotify.time = vncImageDataTargetHead->time;
+      event.u.selectionNotify.requestor = vncImageDataTargetHead->requestor;
+      event.u.selectionNotify.selection = vncImageDataTargetHead->selection;
+      event.u.selectionNotify.target = vncImageDataTargetHead->target;
+      event.u.selectionNotify.property = None;
+      WriteEventsToClient(vncImageDataTargetHead->client, 1, &event);
+    }
+
+    next = vncImageDataTargetHead->next;
+    free(vncImageDataTargetHead);
+    vncImageDataTargetHead = next;
+  }
+}
