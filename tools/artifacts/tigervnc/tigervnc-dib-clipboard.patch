+static int vncConvertSelectionImage(ClientPtr client, Atom selection,
+                                    Atom target, Atom property,
+                                    Window requestor, CARD32 time,
+                                    const uint8_t* data, size_t length)
+{
+  Selection *pSel;
+  WindowPtr pWin;
+  int rc;
+
+  Atom realProperty;
+
+  xEvent event;
+
+  if (data == NULL) {
+    LOG_DEBUG("Selection request for %s (type %s)",
+              NameForAtom(selection), NameForAtom(target));
+  } else {
+    LOG_DEBUG("Sending data for selection request for %s (type %s)",
+              NameForAtom(selection), NameForAtom(target));
+  }
+
+  rc = dixLookupSelection(&pSel, selection, client, DixGetAttrAccess);
+  if (rc != Success)
+    return rc;
+
+  /* We do not validate the time argument because neither does
+   * dix/selection.c and some clients (e.g. Qt) relies on this */
+
+  rc = dixLookupWindow(&pWin, requestor, client, DixSetAttrAccess);
+  if (rc != Success)
+    return rc;
+
+  if (property != None)
+    realProperty = property;
+  else
+    realProperty = target;
+
+  if (target != xaIMAGE_BMP)
+    return BadMatch;
+
+  if (data == NULL) {
+    struct VncDataTarget* vdt;
+
+    vdt = calloc(1, sizeof(struct VncDataTarget));
+    if (vdt == NULL)
+      return BadAlloc;
+
+    vdt->client = client;
+    vdt->selection = selection;
+    vdt->target = target;
+    vdt->property = property;
+    vdt->requestor = requestor;
+    vdt->time = time;
+
+    vdt->next = vncImageDataTargetHead;
+    vncImageDataTargetHead = vdt;
+
+    LOG_DEBUG("Requesting clipboard image data from client");
+
+    vncRequestClipboard();
+
+    return Success;
+  } else {
+    uint8_t* bmp;
+    size_t bmpLen;
+    uint32_t fileSize, dibHeaderSize, pixelOffset;
+
+    /* Need at least the embedded DIB header's own size field to
+     * compute the pixel-data offset. */
+    if (length < 4)
+      return BadMatch;
+
+    bmpLen = 14 + length;
+    bmp = malloc(bmpLen);
+    if (bmp == NULL)
+      return BadAlloc;
