[Desktop Entry]
Name=Claude
Comment=Desktop application for Claude.ai
GenericName=AI Assistant
Keywords=AI;Chat;Assistant;Claude;Code;LLM;
Exec=sh -c 'if [ -x /usr/bin/claude-desktop ]; then exec /usr/bin/claude-desktop --no-sandbox --user-data-dir=/root/.config/Claude --disable-gpu --disable-software-rasterizer --disable-dev-shm-usage "$@"; else exec chromium --app=https://claude.ai --user-data-dir=/root/.config/claude-app --class=Claude --test-type --no-sandbox --disable-gpu --disable-software-rasterizer --disable-dev-shm-usage "$@"; fi' -- %U
Icon=claude-desktop
Type=Application
StartupNotify=true
# Matches the Wayland app_id / X11 WM_CLASS Chromium derives from
# package.json desktopName, so docks group windows under this entry.
StartupWMClass=Claude
# second-instance just focuses mainWindow; suppress GNOME's default "New Window" item
SingleMainWindow=true
Categories=Utility;Development;
MimeType=x-scheme-handler/claude;
Actions=NewChat;NewCode;

[Desktop Action NewChat]
Name=New chat
Exec=sh -c 'if [ -x /usr/bin/claude-desktop ]; then exec /usr/bin/claude-desktop --no-sandbox --user-data-dir=/root/.config/Claude --disable-gpu --disable-software-rasterizer --disable-dev-shm-usage claude://claude.ai/new; else exec chromium --app=https://claude.ai/new --user-data-dir=/root/.config/claude-app --class=Claude --test-type --no-sandbox --disable-gpu --disable-software-rasterizer --disable-dev-shm-usage; fi'

[Desktop Action NewCode]
Name=New Claude Code session
Exec=sh -c 'if [ -x /usr/bin/claude-desktop ]; then exec /usr/bin/claude-desktop --no-sandbox --user-data-dir=/root/.config/Claude --disable-gpu --disable-software-rasterizer --disable-dev-shm-usage claude://code/new; else exec chromium --app=https://claude.ai --user-data-dir=/root/.config/claude-app --class=Claude --test-type --no-sandbox --disable-gpu --disable-software-rasterizer --disable-dev-shm-usage; fi'
