.DS_Store
*.bak-*
local.properties
.gradle/
build/

# Прогон Автоцеха коммитится: без следа на диске его не было.
.autoceh/*/serve.pid
.autoceh/*/dashboard.html

# Большой бинарный образ в assets не коммитится в git
app/src/main/assets/rootfs.tar.zst

# Артефакты проверок — их пишут сами проверки: снимки экрана, дампы окон, журналы.
# Пока они были под git, проверка портила собственное доказательство: прогон менял
# рабочую копию, отпечаток расходился, и `ceh task done` отказывал на зелёном прогоне.
# Это выход проверки, а не исходник; последние всегда лежат на диске.
tests/e2e/artifacts/
store/artifacts/
tools/artifacts/*
# Исключение: .deb и патч TigerVNC — не выход проверки, а коммитимый вход сборки
# образа (R08.1), туда их кладут руками, а не проверки.
!tools/artifacts/tigervnc/
!tools/artifacts/fluent/

# Кэш питона — выход интерпретатора, а не исходник: менялся от каждой правки
# и портил отпечаток рабочей копии на зелёном прогоне.
__pycache__/
*.pyc
.claude/

# Прогоны Чекана — рабочие журналы, в репозиторий не идут.
.chekan/
